{
  "name": "easyhost",
  "version": "0.1.0",
  "description": "EasyHost backend - Docker container management API",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.mts",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest && vitest run --config web/vite.config.mts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "dev:web": "vite --config web/vite.config.mts",
    "test:web": "vitest run --config web/vite.config.mts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cookie-parser": "^1.4.7",
    "dockerode": "^4.0.2",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jsdom": "^25.0.1",
    "prisma": "^5.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
